[Unit]
Description=Ledger Lab host firewall
# Up before the network, as the system's nftables.service would be.
DefaultDependencies=no
Wants=network-pre.target
Before=network-pre.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/ledger-lab/firewall.nft
ExecStop=/usr/sbin/nft delete table inet ledger_lab

[Install]
WantedBy=sysinit.target
