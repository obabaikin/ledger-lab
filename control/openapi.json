{
  "components" : {
    "schemas" : {
      "AddressDeletionAccepted" : {
        "description" : "Deletion is set.",
        "properties" : {
          "alreadyAsked" : {
            "description" : "Whether an earlier request had already set the deletion.",
            "type" : "boolean"
          },
          "deleteAt" : {
            "description" : "From when the address is deleted; asking again keeps the first time.",
            "format" : "date-time",
            "type" : "string"
          }
        },
        "required" : [ "alreadyAsked", "deleteAt" ],
        "type" : "object"
      },
      "AddressDeletionRequest" : {
        "description" : "A mailed link whose address is to be deleted.",
        "properties" : {
          "token" : {
            "description" : "The link's ref, from any mail sent to the address.",
            "type" : [ "string", "null" ]
          }
        },
        "required" : [ "token" ],
        "type" : "object"
      },
      "ApiError" : {
        "description" : "Body of an error answer.",
        "properties" : {
          "error" : {
            "description" : "Names the case; a kebab-case code tells it apart, a phrase together with the status code.",
            "type" : "string"
          }
        },
        "required" : [ "error" ],
        "type" : "object"
      },
      "BankLatency" : {
        "description" : "processedAt − acceptedAt (ledger clock minus gateway clock); null without both.",
        "properties" : {
          "p50Ms" : {
            "format" : "double",
            "type" : [ "number", "null" ]
          },
          "p99Ms" : {
            "format" : "double",
            "type" : [ "number", "null" ]
          }
        },
        "required" : [ "p50Ms", "p99Ms" ],
        "type" : "object"
      },
      "ChaosInRun" : {
        "description" : "A crash of the ledger while the run was active.",
        "properties" : {
          "instances" : {
            "description" : "Instances that took the crash.",
            "items" : {
              "type" : "string"
            },
            "type" : "array"
          },
          "offsetMs" : {
            "description" : "Milliseconds from the clients' start; 0 if the crash came before it.",
            "format" : "int64",
            "type" : "integer"
          }
        },
        "required" : [ "instances", "offsetMs" ],
        "type" : "object"
      },
      "ChaosView" : {
        "description" : "The ledger instances that were crashed.",
        "properties" : {
          "at" : {
            "description" : "When the instances were crashed, by control's clock.",
            "format" : "date-time",
            "type" : "string"
          },
          "instances" : {
            "description" : "Instances that took the crash; those that did not answer are left out.",
            "items" : {
              "type" : "string"
            },
            "type" : "array"
          }
        },
        "required" : [ "at", "instances" ],
        "type" : "object"
      },
      "ClientCounts" : {
        "description" : "What the clients counted, from the generator's status.",
        "properties" : {
          "acknowledged" : {
            "format" : "int64",
            "type" : "integer"
          },
          "duplicatesSent" : {
            "description" : "Second presses of the same transfer; the gateway answers them without a new transfer.",
            "format" : "int64",
            "type" : "integer"
          },
          "failed" : {
            "format" : "int64",
            "type" : "integer"
          },
          "refused" : {
            "description" : "Transfers the gateway refused as busy (503) at least once, retried or not; each counts once.",
            "format" : "int64",
            "type" : "integer"
          },
          "requested" : {
            "format" : "int64",
            "type" : "integer"
          },
          "requestedPerSecond" : {
            "description" : "New transfers per second from the clients' start; index 0 is the first second.",
            "items" : {
              "format" : "int64",
              "type" : "integer"
            },
            "type" : "array"
          },
          "retries" : {
            "format" : "int64",
            "type" : "integer"
          },
          "unknown" : {
            "format" : "int64",
            "type" : "integer"
          }
        },
        "required" : [ "acknowledged", "duplicatesSent", "failed", "refused", "requested", "requestedPerSecond", "retries", "unknown" ],
        "type" : "object"
      },
      "CreateSessionRequest" : {
        "description" : "The invite from the link.",
        "properties" : {
          "token" : {
            "description" : "Token of the invite link.",
            "type" : [ "string", "null" ]
          }
        },
        "required" : [ "token" ],
        "type" : "object"
      },
      "GatewayCounts" : {
        "description" : "What the gateway counted for the run.",
        "properties" : {
          "accepted" : {
            "format" : "int64",
            "type" : "integer"
          },
          "posted" : {
            "format" : "int64",
            "type" : "integer"
          },
          "published" : {
            "format" : "int64",
            "type" : "integer"
          },
          "rejected" : {
            "format" : "int64",
            "type" : "integer"
          }
        },
        "required" : [ "accepted", "posted", "published", "rejected" ],
        "type" : "object"
      },
      "InviteRequest" : {
        "description" : "An address to mail an invite link to.",
        "properties" : {
          "email" : {
            "description" : "Where the link goes; trimmed and lowercased.",
            "type" : [ "string", "null" ]
          },
          "turnstileToken" : {
            "description" : "The Turnstile widget's answer; null where the check is off.",
            "type" : [ "string", "null" ]
          }
        },
        "required" : [ "email", "turnstileToken" ],
        "type" : "object"
      },
      "InviteRequestAccepted" : {
        "description" : "Taken; the same for any address, whether a mail goes out or not."
      },
      "JournalTotals" : {
        "properties" : {
          "acknowledged" : {
            "format" : "int64",
            "type" : "integer"
          },
          "acknowledgedAmountCents" : {
            "format" : "int64",
            "type" : "integer"
          },
          "failed" : {
            "format" : "int64",
            "type" : "integer"
          },
          "refused" : {
            "description" : "Transfers the gateway refused as busy (503) at least once, retried or not; each counts once.",
            "format" : "int64",
            "type" : "integer"
          },
          "requested" : {
            "format" : "int64",
            "type" : "integer"
          },
          "unknown" : {
            "format" : "int64",
            "type" : "integer"
          }
        },
        "required" : [ "acknowledged", "acknowledgedAmountCents", "failed", "refused", "requested", "unknown" ],
        "type" : "object"
      },
      "LedgerCounts" : {
        "description" : "What the ledger applied for the run, and the sums of its books.",
        "properties" : {
          "balanceTotalCents" : {
            "description" : "Sum of the accounts' balances after the run.",
            "format" : "int64",
            "type" : "integer"
          },
          "creditsCents" : {
            "description" : "Sum of the journal's credits.",
            "format" : "int64",
            "type" : "integer"
          },
          "debitsCents" : {
            "description" : "Sum of the journal's debits, as a positive amount.",
            "format" : "int64",
            "type" : "integer"
          },
          "openingTotalCents" : {
            "description" : "Sum of the accounts' opening balances.",
            "format" : "int64",
            "type" : "integer"
          },
          "posted" : {
            "format" : "int64",
            "type" : "integer"
          },
          "rejected" : {
            "format" : "int64",
            "type" : "integer"
          }
        },
        "required" : [ "balanceTotalCents", "creditsCents", "debitsCents", "openingTotalCents", "posted", "rejected" ],
        "type" : "object"
      },
      "LiveView" : {
        "description" : "Live numbers of a running or draining run; each part is the last one read and keeps it while its source cannot be read.",
        "properties" : {
          "chaos" : {
            "description" : "Ledger crashes since the run was admitted, in order; empty if none.",
            "items" : {
              "$ref" : "#/components/schemas/ChaosInRun"
            },
            "type" : "array"
          },
          "clients" : {
            "description" : "null until the generator answered once.",
            "oneOf" : [ {
              "$ref" : "#/components/schemas/ClientCounts"
            }, {
              "type" : "null"
            } ]
          },
          "ledgerDuplicatesAtLeast" : {
            "description" : "Redeliveries the ledger skipped, at least this many: from monitoring, and a killed instance takes its count along. Not part of the verdict.",
            "format" : "int64",
            "type" : [ "integer", "null" ]
          },
          "pods" : {
            "description" : "null until Prometheus answered once.",
            "items" : {
              "$ref" : "#/components/schemas/PodView"
            },
            "type" : [ "array", "null" ]
          },
          "readAt" : {
            "description" : "When control last read any part, by its own clock.",
            "format" : "date-time",
            "type" : "string"
          },
          "stats" : {
            "description" : "The bank's numbers from its events; null until the reporting service answered once.",
            "oneOf" : [ {
              "$ref" : "#/components/schemas/RunStats"
            }, {
              "type" : "null"
            } ]
          }
        },
        "required" : [ "chaos", "clients", "ledgerDuplicatesAtLeast", "pods", "readAt", "stats" ],
        "type" : "object"
      },
      "Operator" : {
        "description" : "Who runs the site.",
        "properties" : {
          "address" : {
            "type" : "string"
          },
          "email" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          }
        },
        "required" : [ "address", "email", "name" ],
        "type" : "object"
      },
      "PodView" : {
        "description" : "One instance of a service, from Prometheus; approximate, a scrape or two behind.",
        "properties" : {
          "instance" : {
            "type" : "string"
          },
          "job" : {
            "type" : "string"
          },
          "partitions" : {
            "description" : "Partitions the ledger instance consumes; null for other services.",
            "format" : "int32",
            "type" : [ "integer", "null" ]
          },
          "up" : {
            "description" : "The last scrape got an answer.",
            "type" : "boolean"
          }
        },
        "required" : [ "instance", "job", "partitions", "up" ],
        "type" : "object"
      },
      "ReconciliationBreaks" : {
        "properties" : {
          "acknowledgedNotInStatement" : {
            "$ref" : "#/components/schemas/TransferIds"
          },
          "failedButInStatement" : {
            "$ref" : "#/components/schemas/TransferIds"
          },
          "notInJournal" : {
            "$ref" : "#/components/schemas/TransferIds"
          },
          "payloadMismatch" : {
            "$ref" : "#/components/schemas/TransferIds"
          },
          "statusMismatch" : {
            "$ref" : "#/components/schemas/TransferIds"
          }
        },
        "required" : [ "acknowledgedNotInStatement", "failedButInStatement", "notInJournal", "payloadMismatch", "statusMismatch" ],
        "type" : "object"
      },
      "RunList" : {
        "description" : "A session's runs, newest first.",
        "properties" : {
          "items" : {
            "items" : {
              "$ref" : "#/components/schemas/RunView"
            },
            "type" : "array"
          }
        },
        "required" : [ "items" ],
        "type" : "object"
      },
      "RunReport" : {
        "description" : "The verdict of a run and what it rests on.",
        "properties" : {
          "bankLatencyP50Ms" : {
            "description" : "Bank latency p50, ms: accepted to result known, by the gateway's clock; null without results.",
            "format" : "double",
            "type" : [ "number", "null" ]
          },
          "bankLatencyP99Ms" : {
            "description" : "Bank latency p99, ms, as bankLatencyP50Ms.",
            "format" : "double",
            "type" : [ "number", "null" ]
          },
          "bankViewsAgree" : {
            "description" : "Gateway and ledger count the same posted and rejected transfers and reasons; null if the drain did not finish.",
            "type" : [ "boolean", "null" ]
          },
          "breaks" : {
            "description" : "Discrepancies between journal and statement, by kind, with up to 1000 ids each.",
            "oneOf" : [ {
              "$ref" : "#/components/schemas/ReconciliationBreaks"
            }, {
              "type" : "null"
            } ]
          },
          "chaos" : {
            "description" : "Ledger crashes while the run was active, in order; empty if none.",
            "items" : {
              "$ref" : "#/components/schemas/ChaosInRun"
            },
            "type" : "array"
          },
          "client" : {
            "description" : "What the clients were told; null without a client reconciliation.",
            "oneOf" : [ {
              "$ref" : "#/components/schemas/JournalTotals"
            }, {
              "type" : "null"
            } ]
          },
          "clientBalanced" : {
            "description" : "The clients' journal matches the statement; null without a client reconciliation.",
            "type" : [ "boolean", "null" ]
          },
          "clientLatencyP50Ms" : {
            "description" : "Client latency p50, ms: a waiting client's first press to a final status, exact over the run; presses whose wait ran out are left out; null without one.",
            "format" : "double",
            "type" : [ "number", "null" ]
          },
          "clientLatencyP99Ms" : {
            "description" : "Client latency p99, ms, as clientLatencyP50Ms.",
            "format" : "double",
            "type" : [ "number", "null" ]
          },
          "gateway" : {
            "$ref" : "#/components/schemas/GatewayCounts"
          },
          "ledger" : {
            "$ref" : "#/components/schemas/LedgerCounts"
          },
          "ledgerBalanced" : {
            "description" : "The ledger's books: balances, journal and transfer log agree.",
            "type" : "boolean"
          },
          "ledgerDuplicatesAtLeast" : {
            "description" : "Redeliveries the ledger skipped, at least this many, from monitoring; null if never read.",
            "format" : "int64",
            "type" : [ "integer", "null" ]
          },
          "ledgerFailedChecks" : {
            "items" : {
              "enum" : [ "TOTAL_BALANCE_CONSERVED", "JOURNAL_SUMS_TO_ZERO", "JOURNAL_MATCHES_TRANSFER_LOG", "EVERY_ACCOUNT_MATCHES_JOURNAL" ],
              "type" : "string"
            },
            "type" : "array"
          },
          "notes" : {
            "description" : "What the report could not show; does not decide the verdict.",
            "items" : {
              "type" : "string"
            },
            "type" : "array"
          },
          "projectionMatchesBooks" : {
            "description" : "The projection counts what the books count: commands seen as accepted, posted, rejected; null without stats.",
            "type" : [ "boolean", "null" ]
          },
          "reasons" : {
            "description" : "What the verdict could not check, with or without breaks; empty if nothing was missing.",
            "items" : {
              "type" : "string"
            },
            "type" : "array"
          },
          "rejectionsByReason" : {
            "additionalProperties" : {
              "format" : "int64",
              "type" : "integer"
            },
            "description" : "Rejections by reason, as the ledger decided them.",
            "type" : "object"
          },
          "result" : {
            "enum" : [ "BALANCED", "BREAKS", "INCOMPLETE" ],
            "type" : "string"
          },
          "statementFinal" : {
            "description" : "No statement line was still in flight; null without a client reconciliation.",
            "type" : [ "boolean", "null" ]
          },
          "stats" : {
            "description" : "The run's numbers from the bank's events, for the page; null if the reporting service could not be read.",
            "oneOf" : [ {
              "$ref" : "#/components/schemas/RunStats"
            }, {
              "type" : "null"
            } ]
          },
          "unknownResolved" : {
            "description" : "Transfers the clients did not know the outcome of, settled by the statement.",
            "oneOf" : [ {
              "$ref" : "#/components/schemas/UnknownResolved"
            }, {
              "type" : "null"
            } ]
          }
        },
        "required" : [ "bankLatencyP50Ms", "bankLatencyP99Ms", "bankViewsAgree", "breaks", "chaos", "client", "clientBalanced", "clientLatencyP50Ms", "clientLatencyP99Ms", "gateway", "ledger", "ledgerBalanced", "ledgerDuplicatesAtLeast", "ledgerFailedChecks", "notes", "projectionMatchesBooks", "reasons", "rejectionsByReason", "result", "statementFinal", "stats", "unknownResolved" ],
        "type" : "object"
      },
      "RunStats" : {
        "description" : "A run's numbers from the bank's events, as the reporting service had them at `at`; they trail the books while events are on the way.",
        "properties" : {
          "at" : {
            "description" : "Time of the snapshot, by the reporting database's clock.",
            "format" : "date-time",
            "type" : "string"
          },
          "bankLatency" : {
            "$ref" : "#/components/schemas/BankLatency"
          },
          "runId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "series" : {
            "description" : "Increments per second, oldest first.",
            "items" : {
              "$ref" : "#/components/schemas/SecondStats"
            },
            "type" : "array"
          },
          "totals" : {
            "$ref" : "#/components/schemas/StatsTotals"
          }
        },
        "required" : [ "at", "bankLatency", "runId", "series", "totals" ],
        "type" : "object"
      },
      "RunView" : {
        "description" : "A run as control sees it now.",
        "properties" : {
          "admittedAt" : {
            "description" : "When the run left the queue; null while queued or if it expired.",
            "format" : "date-time",
            "type" : [ "string", "null" ]
          },
          "booksFinalAt" : {
            "description" : "When control first saw the books final: every accepted transfer applied; reconciling from then on. null before.",
            "format" : "date-time",
            "type" : [ "string", "null" ]
          },
          "closedAt" : {
            "description" : "When the bank closed the run's period, by the bank's clock; null before.",
            "format" : "date-time",
            "type" : [ "string", "null" ]
          },
          "createdAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "durationSeconds" : {
            "format" : "int32",
            "type" : "integer"
          },
          "failure" : {
            "description" : "Why the run failed without a verdict; only when failed.",
            "type" : [ "string", "null" ]
          },
          "finishedAt" : {
            "description" : "When the run reached a final state; null before.",
            "format" : "date-time",
            "type" : [ "string", "null" ]
          },
          "live" : {
            "description" : "Live numbers; only in a run's own GET while running or draining, else null. The report keeps the final ones.",
            "oneOf" : [ {
              "$ref" : "#/components/schemas/LiveView"
            }, {
              "type" : "null"
            } ]
          },
          "position" : {
            "description" : "Place in the queue, from 1; only while queued.",
            "format" : "int64",
            "type" : [ "integer", "null" ]
          },
          "result" : {
            "description" : "The verdict; only once reconciled. Only BALANCED is green.",
            "enum" : [ "BALANCED", "BREAKS", "INCOMPLETE" ],
            "type" : [ "string", "null" ]
          },
          "runId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "startedAt" : {
            "description" : "When the clients started sending; null before.",
            "format" : "date-time",
            "type" : [ "string", "null" ]
          },
          "state" : {
            "enum" : [ "QUEUED", "CREATED", "RUNNING", "DRAINING", "RECONCILED", "FAILED", "EXPIRED" ],
            "type" : "string"
          },
          "stopRequested" : {
            "description" : "A stop was asked for while the run was running.",
            "type" : "boolean"
          },
          "tps" : {
            "format" : "int32",
            "type" : "integer"
          },
          "waitingFor" : {
            "description" : "WARM_UP while queued because the bank is not ready: the ledger takes its partitions (after a start or a crash), the gateway warms up, or Prometheus cannot tell; null otherwise.",
            "enum" : [ "WARM_UP" ],
            "type" : [ "string", "null" ]
          }
        },
        "required" : [ "admittedAt", "booksFinalAt", "closedAt", "createdAt", "durationSeconds", "failure", "finishedAt", "live", "position", "result", "runId", "startedAt", "state", "stopRequested", "tps", "waitingFor" ],
        "type" : "object"
      },
      "SecondStats" : {
        "properties" : {
          "accepted" : {
            "description" : "By acceptedAt, or by processedAt while the command is not seen yet.",
            "format" : "int64",
            "type" : "integer"
          },
          "bankP50Ms" : {
            "format" : "double",
            "type" : [ "number", "null" ]
          },
          "bankP99Ms" : {
            "format" : "double",
            "type" : [ "number", "null" ]
          },
          "posted" : {
            "description" : "By processedAt, as the rest.",
            "format" : "int64",
            "type" : "integer"
          },
          "postedAmountCents" : {
            "format" : "int64",
            "type" : "integer"
          },
          "rejected" : {
            "format" : "int64",
            "type" : "integer"
          },
          "second" : {
            "description" : "Start of the second.",
            "format" : "date-time",
            "type" : "string"
          }
        },
        "required" : [ "accepted", "bankP50Ms", "bankP99Ms", "posted", "postedAmountCents", "rejected", "second" ],
        "type" : "object"
      },
      "SessionCreated" : {
        "description" : "A new session; its id is the key to it.",
        "properties" : {
          "sessionId" : {
            "format" : "uuid",
            "type" : "string"
          }
        },
        "required" : [ "sessionId" ],
        "type" : "object"
      },
      "SessionView" : {
        "description" : "What a session may do now.",
        "properties" : {
          "chaosAvailable" : {
            "description" : "Whether the chaos button works in this deployment.",
            "type" : "boolean"
          },
          "chaosReadyInSeconds" : {
            "description" : "Seconds until chaos may be used again, on the whole cluster; 0 when it may be used now.",
            "format" : "int64",
            "type" : "integer"
          },
          "defaultTps" : {
            "description" : "Transfers per second chosen when the page opens; one of tpsOptions.",
            "format" : "int32",
            "type" : "integer"
          },
          "durationOptions" : {
            "description" : "Allowed run durations, seconds.",
            "items" : {
              "format" : "int32",
              "type" : "integer"
            },
            "type" : "array"
          },
          "inviteValid" : {
            "description" : "False once the invite expired or was switched off; runs can then only be read.",
            "type" : "boolean"
          },
          "runsLastHour" : {
            "description" : "Runs started with the invite in the last hour, from any session.",
            "format" : "int64",
            "type" : "integer"
          },
          "runsPerHour" : {
            "description" : "Runs the invite may start in any hour.",
            "format" : "int32",
            "type" : "integer"
          },
          "sessionId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "tpsOptions" : {
            "description" : "Allowed transfers per second.",
            "items" : {
              "format" : "int32",
              "type" : "integer"
            },
            "type" : "array"
          }
        },
        "required" : [ "chaosAvailable", "chaosReadyInSeconds", "defaultTps", "durationOptions", "inviteValid", "runsLastHour", "runsPerHour", "sessionId", "tpsOptions" ],
        "type" : "object"
      },
      "SiteView" : {
        "description" : "What the start, privacy and imprint pages show.",
        "properties" : {
          "linkDays" : {
            "description" : "Days a mailed link works.",
            "format" : "int64",
            "type" : "integer"
          },
          "linksPerDay" : {
            "description" : "Links an address may get in a day.",
            "format" : "int32",
            "type" : "integer"
          },
          "operator" : {
            "description" : "null where the deployment has not set them.",
            "oneOf" : [ {
              "$ref" : "#/components/schemas/Operator"
            }, {
              "type" : "null"
            } ]
          },
          "retentionDays" : {
            "description" : "Days without use after which an address is deleted.",
            "format" : "int64",
            "type" : "integer"
          },
          "turnstileSiteKey" : {
            "description" : "The Turnstile widget's site key; null where the check is off.",
            "type" : [ "string", "null" ]
          }
        },
        "required" : [ "linkDays", "linksPerDay", "operator", "retentionDays", "turnstileSiteKey" ],
        "type" : "object"
      },
      "StartRunRequest" : {
        "description" : "A run to start.",
        "properties" : {
          "durationSeconds" : {
            "description" : "Seconds, one of the session's durationOptions.",
            "format" : "int32",
            "type" : [ "integer", "null" ]
          },
          "requestId" : {
            "description" : "Idempotency key within the session: a repeat with the same body gets the same run.",
            "format" : "uuid",
            "type" : [ "string", "null" ]
          },
          "tps" : {
            "description" : "Transfers per second, one of the session's tpsOptions.",
            "format" : "int32",
            "type" : [ "integer", "null" ]
          }
        },
        "required" : [ "durationSeconds", "requestId", "tps" ],
        "type" : "object"
      },
      "StatsTotals" : {
        "properties" : {
          "accepted" : {
            "description" : "Transfers the gateway accepted, including those known only by their result so far.",
            "format" : "int64",
            "type" : "integer"
          },
          "commandsSeen" : {
            "description" : "Transfers whose command is seen: their amount and acceptedAt are known.",
            "format" : "int64",
            "type" : "integer"
          },
          "inFlight" : {
            "description" : "accepted − posted − rejected.",
            "format" : "int64",
            "type" : "integer"
          },
          "posted" : {
            "format" : "int64",
            "type" : "integer"
          },
          "postedAmountCents" : {
            "description" : "Sum of posted transfers whose amount is known.",
            "format" : "int64",
            "type" : "integer"
          },
          "rejected" : {
            "format" : "int64",
            "type" : "integer"
          },
          "rejectedByReason" : {
            "additionalProperties" : {
              "format" : "int64",
              "type" : "integer"
            },
            "type" : "object"
          }
        },
        "required" : [ "accepted", "commandsSeen", "inFlight", "posted", "postedAmountCents", "rejected", "rejectedByReason" ],
        "type" : "object"
      },
      "TransferIds" : {
        "properties" : {
          "count" : {
            "format" : "int64",
            "type" : "integer"
          },
          "transferIds" : {
            "items" : {
              "format" : "uuid",
              "type" : "string"
            },
            "type" : "array"
          }
        },
        "required" : [ "count", "transferIds" ],
        "type" : "object"
      },
      "UnknownResolved" : {
        "properties" : {
          "accepted" : {
            "$ref" : "#/components/schemas/TransferIds"
          },
          "notAccepted" : {
            "$ref" : "#/components/schemas/TransferIds"
          }
        },
        "required" : [ "accepted", "notAccepted" ],
        "type" : "object"
      }
    }
  },
  "info" : {
