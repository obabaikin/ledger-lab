{
  "components" : {
    "schemas" : {
      "AccountMismatch" : {
        "properties" : {
          "accountNo" : {
            "format" : "int32",
            "type" : "integer"
          },
          "balanceChangeCents" : {
            "description" : "Balance at the end of the period minus the balance at its start",
            "format" : "int64",
            "type" : "integer"
          },
          "journalCents" : {
            "description" : "Sum of the account's journal entries of the period",
            "format" : "int64",
            "type" : "integer"
          }
        },
        "type" : "object"
      },
      "ApiError" : {
        "description" : "Body of an error answer.",
        "properties" : {
          "error" : {
            "description" : "Names the case.",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "Books" : {
        "properties" : {
          "accounts" : {
            "format" : "int64",
            "type" : "integer"
          },
          "balanceTotalCents" : {
            "description" : "All balances, the pool's included, plus the credits not yet applied",
            "format" : "int64",
            "type" : "integer"
          },
          "balanced" : {
            "type" : "boolean"
          },
          "openingTotalCents" : {
            "format" : "int64",
            "type" : "integer"
          }
        },
        "type" : "object"
      },
      "PeriodCheck" : {
        "properties" : {
          "accountExamples" : {
            "description" : "The first of them, up to the configured number",
            "items" : {
              "$ref" : "#/components/schemas/AccountMismatch"
            },
            "type" : "array"
          },
          "accountsCompared" : {
            "description" : "False when the period before has no snapshot of the balances: the accounts were not compared",
            "type" : "boolean"
          },
          "accountsOutOfBalance" : {
            "format" : "int64",
            "type" : "integer"
          },
          "balanced" : {
            "type" : "boolean"
          },
          "creditsCents" : {
            "format" : "int64",
            "type" : "integer"
          },
          "debitsCents" : {
            "format" : "int64",
            "type" : "integer"
          },
          "failedChecks" : {
            "items" : {
              "enum" : [ "JOURNAL_DEBITS_EQUAL_CREDITS", "JOURNAL_MATCHES_TRANSFER_LOG", "EVERY_ACCOUNT_MATCHES_JOURNAL" ],
              "type" : "string"
            },
            "type" : "array"
          },
          "invalidJournalExamples" : {
            "description" : "The first of them, up to the configured number",
            "items" : {
              "format" : "uuid",
              "type" : "string"
            },
            "type" : "array"
          },
          "journalEntries" : {
            "format" : "int64",
            "type" : "integer"
          },
          "transfersWithInvalidJournal" : {
            "format" : "int64",
            "type" : "integer"
          }
        },
        "type" : "object"
      },
      "PeriodReconciliation" : {
        "properties" : {
          "check" : {
            "$ref" : "#/components/schemas/PeriodCheck",
            "description" : "Absent until the check asked for by POST has finished"
          },
          "periodStart" : {
            "format" : "date-time",
            "type" : "string"
          },
          "poolPostings" : {
            "description" : "Postings of cash pooling; not among the transfers above",
            "format" : "int64",
            "type" : "integer"
          },
          "postedTransfers" : {
            "format" : "int64",
            "type" : "integer"
          },
          "rejectedTransfers" : {
            "format" : "int64",
            "type" : "integer"
          },
          "rejectionsByReason" : {
            "additionalProperties" : {
              "format" : "int64",
              "type" : "integer"
            },
            "type" : "object"
          }
        },
        "type" : "object"
      }
    }
  },
  "info" : {
    "description" : "The ledger's view of a period and of the bank's books, for control.",
    "title" : "Ledger Lab ledger internal API",
    "version" : "1"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/internal/books" : {
      "get" : {
        "operationId" : "books",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Books"
                }
              }
            },
            "description" : "The sums as of now"
          },
          "503" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "The database cancelled the query at the statement timeout"
          }
        },
        "summary" : "All balances against all opening balances",
        "tags" : [ "period-controller" ]
      }
    },
    "/internal/periods/{periodStart}/check" : {
      "post" : {
        "operationId" : "check",
        "parameters" : [ {
          "in" : "path",
          "name" : "periodStart",
          "required" : true,
          "schema" : {
            "format" : "date-time",
            "type" : "string"
          }
        } ],
        "responses" : {
          "202" : {
            "description" : "Started, running or already made; the reconciliation shows it when finished"
          },
          "404" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "Not a period, not ended yet, or older than the ledger keeps"
          }
        },
        "summary" : "Start the period's check in the background; call once all its transfers are booked",
        "tags" : [ "period-controller" ]
      }
    },
    "/internal/periods/{periodStart}/reconciliation" : {
      "get" : {
        "operationId" : "reconciliation",
        "parameters" : [ {
          "in" : "path",
          "name" : "periodStart",
          "required" : true,
          "schema" : {
            "format" : "date-time",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PeriodReconciliation"
                }
              }
            },
            "description" : "Counted now; the check is absent until it has finished"
          },
          "404" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "Not a period, not ended yet, or older than the ledger keeps"
          },
          "503" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "The database cancelled a query at the statement timeout"
          }
        },
        "summary" : "Transfers of an ended period by outcome, and its check once made",
        "tags" : [ "period-controller" ]
      }
    }
  }
}