{
  "components" : {
    "schemas" : {
      "ApiError" : {
        "description" : "Body of an error answer.",
        "properties" : {
          "error" : {
            "description" : "Names the case; the status code tells it apart.",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "Statement" : {
        "description" : "One page of a closed period's statement.",
        "properties" : {
          "closedAt" : {
            "description" : "When the period was closed; every transfer accepted in it had been written by then.",
            "format" : "date-time",
            "type" : "string"
          },
          "entryCount" : {
            "description" : "Lines in the whole statement, any status; the same on every page.",
            "format" : "int64",
            "type" : "integer"
          },
          "items" : {
            "items" : {
              "$ref" : "#/components/schemas/StatementLine"
            },
            "type" : "array"
          },
          "next" : {
            "description" : "Pass as `after` for the next page; null on the last page.",
            "type" : [ "string", "null" ]
          },
          "periodStart" : {
            "format" : "date-time",
            "type" : "string"
          }
        },
        "required" : [ "entryCount" ],
        "type" : "object"
      },
      "StatementLine" : {
        "description" : "A transfer the bank accepted in the period.",
        "properties" : {
          "acceptedAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "amountCents" : {
            "format" : "int64",
            "type" : "integer"
          },
          "fromAccount" : {
            "format" : "int32",
            "type" : "integer"
          },
          "rejectReason" : {
            "description" : "Set when status is REJECTED; null if the reason is newer than this API version.",
            "enum" : [ "INVALID_AMOUNT", "SAME_ACCOUNT", "UNKNOWN_ACCOUNT", "BLOCKED_ACCOUNT", "INSUFFICIENT_FUNDS", "DAILY_LIMIT_EXCEEDED" ],
            "type" : [ "string", "null" ]
          },
          "resultedAt" : {
            "description" : "When the final status was recorded; null while not final.",
            "format" : "date-time",
            "type" : [ "string", "null" ]
          },
          "status" : {
            "description" : "A transfer's state at the bank; POSTED and REJECTED are final.",
            "enum" : [ "ACCEPTED", "PUBLISHED", "POSTED", "REJECTED" ],
            "type" : "string"
          },
          "toAccount" : {
            "format" : "int32",
            "type" : "integer"
          },
          "transferId" : {
            "format" : "uuid",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "SubmitTransferRequest" : {
        "description" : "A transfer to submit.",
        "properties" : {
          "amountCents" : {
            "format" : "int64",
            "minimum" : 1,
            "type" : "integer"
          },
          "fromAccount" : {
            "format" : "int32",
            "minimum" : 1,
            "type" : "integer"
          },
          "toAccount" : {
            "format" : "int32",
            "minimum" : 1,
            "type" : "integer"
          },
          "transferId" : {
            "description" : "Idempotency key: a repeat with the same body within the idempotency window gets the same transfer.",
            "format" : "uuid",
            "type" : [ "string", "null" ]
          }
        },
        "required" : [ "amountCents", "fromAccount", "toAccount", "transferId" ],
        "type" : "object"
      },
      "TransferResponse" : {
        "description" : "A transfer as the bank sees it now.",
        "properties" : {
          "acceptedAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "rejectReason" : {
            "description" : "Set when status is REJECTED; null if the reason is newer than this API version.",
            "enum" : [ "INVALID_AMOUNT", "SAME_ACCOUNT", "UNKNOWN_ACCOUNT", "BLOCKED_ACCOUNT", "INSUFFICIENT_FUNDS", "DAILY_LIMIT_EXCEEDED" ],
            "type" : [ "string", "null" ]
          },
          "resultedAt" : {
            "description" : "When the final status was recorded; null while not final.",
            "format" : "date-time",
            "type" : [ "string", "null" ]
          },
          "status" : {
            "description" : "A transfer's state at the bank; POSTED and REJECTED are final.",
            "enum" : [ "ACCEPTED", "PUBLISHED", "POSTED", "REJECTED" ],
            "type" : "string"
          },
          "transferId" : {
            "format" : "uuid",
            "type" : "string"
          }
        },
        "type" : "object"
      }
    }
  },
  "info" : {
    "description" : "Transfers and the statement of a closed period. Periods are PT1H long, on a grid from the epoch. A transfer and its key are kept for PT4H (the idempotency window): after that the transfer is no longer found, and the same key is taken as a new transfer.",
    "title" : "Ledger Lab bank API",
    "version" : "2"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/v2/periods/{periodStart}/statement" : {
      "get" : {
        "operationId" : "statement",
        "parameters" : [ {
          "description" : "Start of the period, an ISO-8601 instant on the bank's grid of periods",
          "in" : "path",
          "name" : "periodStart",
          "required" : true,
          "schema" : {
            "format" : "date-time",
            "type" : "string"
          }
        }, {
          "description" : "The `next` of the previous page; omit for the first page",
          "in" : "query",
          "name" : "after",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "Page size, 1 to 1000, default 100",
          "in" : "query",
          "name" : "limit",
          "required" : false,
          "schema" : {
            "format" : "int32",
            "type" : "integer"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Statement"
                }
              }
            },
            "description" : "The page"
          },
          "400" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "Invalid limit, or `after` is not the `next` of a page of this period"
          },
          "404" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "Not a period, not begun yet, or older than the bank keeps transfers"
          },
          "409" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "The period is not closed yet"
          }
        },
        "summary" : "A page of a closed period's statement: the transfers accepted in it, in the order accepted",
        "tags" : [ "statement-controller" ]
      }
    },
    "/v2/transfers" : {
      "post" : {
        "operationId" : "submit",
        "parameters" : [ {
          "description" : "ISO-8601 duration to wait for the final status, capped by the bank",
          "in" : "query",
          "name" : "wait",
          "required" : false,
          "schema" : {
            "format" : "duration",
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/SubmitTransferRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TransferResponse"
                }
              }
            },
            "description" : "Final status"
          },
          "202" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TransferResponse"
                }
              }
            },
            "description" : "Accepted, not final yet; Retry-After says when to ask again"
          },
          "400" : {
            "description" : "Invalid body"
          },
          "422" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "The key was used with a different body within the idempotency window"
          },
          "503" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "With error \"busy\" (too many transfers in progress) or \"stopping\" (this instance is shutting down): the transfer was not taken; retry with the same key after Retry-After. Any other 5xx leaves the transfer unknown."
          }
        },
        "summary" : "Submit a transfer",
        "tags" : [ "transfer-controller" ]
      }
    },
    "/v2/transfers/{transferId}" : {
      "get" : {
        "operationId" : "status",
        "parameters" : [ {
          "in" : "path",
          "name" : "transferId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TransferResponse"
                }
              }
            },
            "description" : "Final status"
          },
          "202" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TransferResponse"
                }
              }
            },
            "description" : "Not final yet; Retry-After says when to ask again"
          },
          "404" : {
            "description" : "Not accepted, or accepted longer ago than the idempotency window"
          }
        },
        "summary" : "A transfer's current status",
        "tags" : [ "transfer-controller" ]
      }
    }
  }
}