{
  "components" : {
    "schemas" : {
      "ApiError" : {
        "description" : "Body of an error answer.",
        "properties" : {
          "error" : {
            "description" : "Names the case; the status code tells it apart.",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "ClosedPeriod" : {
        "properties" : {
          "closedAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "entryCount" : {
            "description" : "Transfers accepted in the period, any status.",
            "format" : "int64",
            "type" : "integer"
          },
          "periodStart" : {
            "format" : "date-time",
            "type" : "string"
          }
        },
        "required" : [ "entryCount" ],
        "type" : "object"
      },
      "PeriodSummary" : {
        "properties" : {
          "accepted" : {
            "format" : "int64",
            "type" : "integer"
          },
          "periodStart" : {
            "format" : "date-time",
            "type" : "string"
          },
          "posted" : {
            "format" : "int64",
            "type" : "integer"
          },
          "published" : {
            "format" : "int64",
            "type" : "integer"
          },
          "rejected" : {
            "format" : "int64",
            "type" : "integer"
          },
          "rejectionsByReason" : {
            "additionalProperties" : {
              "format" : "int64",
              "type" : "integer"
            },
            "type" : "object"
          }
        },
        "required" : [ "accepted", "posted", "published", "rejected" ],
        "type" : "object"
      }
    }
  },
  "info" : {
    "description" : "Period summary and period close, for control.",
    "title" : "Ledger Lab gateway internal API",
    "version" : "2"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/internal/periods/{periodStart}/close" : {
      "post" : {
        "operationId" : "close",
        "parameters" : [ {
          "in" : "path",
          "name" : "periodStart",
          "required" : true,
          "schema" : {
            "format" : "date-time",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ClosedPeriod"
                }
              }
            },
            "description" : "Closed; a repeat returns the same answer"
          },
          "404" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "Not a period, not ended yet, or older than the gateway keeps"
          },
          "503" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "Inserts in flight kept the lock past the timeout; ask again"
          }
        },
        "summary" : "Close an ended period: fix the set of its transfers",
        "tags" : [ "period-controller" ]
      }
    },
    "/internal/periods/{periodStart}/summary" : {
      "get" : {
        "operationId" : "summary",
        "parameters" : [ {
          "in" : "path",
          "name" : "periodStart",
          "required" : true,
          "schema" : {
            "format" : "date-time",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PeriodSummary"
                }
              }
            },
            "description" : "Counted now"
          },
          "404" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "Not a period, not begun yet, or older than the gateway keeps"
          }
        },
        "summary" : "Transfers accepted in the period, by status",
        "tags" : [ "period-controller" ]
      }
    }
  }
}