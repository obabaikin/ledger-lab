{
  "components" : {
    "schemas" : {
      "ApiError" : {
        "description" : "Body of an error answer.",
        "properties" : {
          "error" : {
            "description" : "Names the case; the status code tells it apart.",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "PeriodStats" : {
        "description" : "The transfers accepted in a period as seen in the bank's events; one consistent snapshot, lagging the books while events are on the way.",
        "properties" : {
          "accepted" : {
            "description" : "Transfers the gateway accepted, including those known only by their result so far.",
            "format" : "int64",
            "type" : "integer"
          },
          "at" : {
            "description" : "Time of the snapshot, by the reporting database's clock.",
            "format" : "date-time",
            "type" : "string"
          },
          "commandsSeen" : {
            "description" : "Transfers whose command is seen: their amount is known.",
            "format" : "int64",
            "type" : "integer"
          },
          "periodStart" : {
            "format" : "date-time",
            "type" : "string"
          },
          "posted" : {
            "format" : "int64",
            "type" : "integer"
          },
          "postedAmountCents" : {
            "description" : "Sum of posted transfers whose amount is known.",
            "format" : "int64",
            "type" : "integer"
          },
          "rejected" : {
            "format" : "int64",
            "type" : "integer"
          },
          "rejectionsByReason" : {
            "additionalProperties" : {
              "format" : "int64",
              "type" : "integer"
            },
            "description" : "Rejected transfers by reason; a reason this service does not know is kept as sent.",
            "type" : "object"
          }
        },
        "required" : [ "accepted", "at", "commandsSeen", "periodStart", "posted", "postedAmountCents", "rejected", "rejectionsByReason" ],
        "type" : "object"
      }
    }
  },
  "info" : {
    "description" : "A period's numbers from the bank's events, for control.",
    "title" : "Ledger Lab reporting internal API",
    "version" : "2"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/internal/periods/current/stats" : {
      "get" : {
        "operationId" : "current",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PeriodStats"
                }
              }
            },
            "description" : "The snapshot; a period with no events yet has zeros"
          }
        },
        "summary" : "The current period's numbers from the bank's events",
        "tags" : [ "period-stats-controller" ]
      }
    },
    "/internal/periods/{periodStart}/stats" : {
      "get" : {
        "operationId" : "stats",
        "parameters" : [ {
          "in" : "path",
          "name" : "periodStart",
          "required" : true,
          "schema" : {
            "format" : "date-time",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PeriodStats"
                }
              }
            },
            "description" : "The snapshot; a period with no events has zeros"
          },
          "404" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "Not a period, not begun yet, or older than reporting keeps"
          }
        },
        "summary" : "A period's numbers from the bank's events",
        "tags" : [ "period-stats-controller" ]
      }
    }
  }
}