{
  "components" : {
    "schemas" : {
      "ApiError" : {
        "description" : "Body of an error answer.",
        "properties" : {
          "error" : {
            "description" : "Names the case.",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "ClientReconciliationReport" : {
        "description" : "The client journal against the bank's statement of one closed period.",
        "properties" : {
          "acceptedByJournal" : {
            "description" : "Transfers the client knows the bank accepted in the period, those it learned by asking included.",
            "format" : "int64",
            "type" : "integer"
          },
          "balanced" : {
            "description" : "No break of any kind.",
            "type" : "boolean"
          },
          "breaks" : {
            "$ref" : "#/components/schemas/ReconciliationBreaks"
          },
          "periodStart" : {
            "format" : "date-time",
            "type" : "string"
          },
          "statement" : {
            "$ref" : "#/components/schemas/StatementTotals"
          },
          "statementFinal" : {
            "description" : "Every line of the statement has a final status this client can read.",
            "type" : "boolean"
          },
          "unknownResolved" : {
            "$ref" : "#/components/schemas/UnknownResolved"
          }
        },
        "type" : "object"
      },
      "ClientTotals" : {
        "description" : "What became of the clients' transfers since the bank started, whichever generator sent them.",
        "properties" : {
          "acknowledged" : {
            "description" : "Transfers the bank took (any 2xx).",
            "format" : "int64",
            "type" : "integer"
          },
          "gaveUp" : {
            "description" : "Transfers whose client stopped trying: refused for good, or without an answer, whatever the bank said when asked later.",
            "format" : "int64",
            "type" : "integer"
          },
          "sent" : {
            "description" : "Transfers the clients sent: each intent the journal stored.",
            "format" : "int64",
            "type" : "integer"
          },
          "unanswered" : {
            "description" : "Sent, without an outcome yet: in flight, or given up and not yet asked about.",
            "format" : "int64",
            "type" : "integer"
          }
        },
        "type" : "object"
      },
      "LoadStatus" : {
        "description" : "The clients' load now, what became of their transfers since this generator started, and in total since the bank started.",
        "properties" : {
          "acknowledged" : {
            "description" : "Transfers the bank took (any 2xx).",
            "format" : "int64",
            "type" : "integer"
          },
          "baseTps" : {
            "description" : "New transfers a second without a pulse, now.",
            "format" : "int32",
            "type" : "integer"
          },
          "duplicatesSent" : {
            "description" : "Second sends of the same transfer, as a user pressing twice; not new transfers.",
            "format" : "int64",
            "type" : "integer"
          },
          "failed" : {
            "description" : "The client gave up and the bank does not have the transfer: refused on every attempt, or never reached.",
            "format" : "int64",
            "type" : "integer"
          },
          "inFlight" : {
            "format" : "int64",
            "type" : "integer"
          },
          "nextChangeAt" : {
            "description" : "When the base changes next; null while it is constant.",
            "format" : "date-time",
            "type" : [ "string", "null" ]
          },
          "notJournaled" : {
            "description" : "Transfers not sent because the client journal could not store them first.",
            "format" : "int64",
            "type" : "integer"
          },
          "posted" : {
            "description" : "Of the clients that waited for the final status: posted.",
            "format" : "int64",
            "type" : "integer"
          },
          "pulse" : {
            "oneOf" : [ {
              "$ref" : "#/components/schemas/Pulse"
            }, {
              "type" : "null"
            } ]
          },
          "refused" : {
            "description" : "Transfers the gateway refused as busy (503) at least once, retried or not; each counts once.",
            "format" : "int64",
            "type" : "integer"
          },
          "rejected" : {
            "description" : "Of the clients that waited for the final status: rejected by the bank's rules.",
            "format" : "int64",
            "type" : "integer"
          },
          "rejectedByReason" : {
            "additionalProperties" : {
              "format" : "int64",
              "type" : "integer"
            },
            "type" : "object"
          },
          "requested" : {
            "description" : "Transfers the clients set out to send.",
            "format" : "int64",
            "type" : "integer"
          },
          "restarted" : {
            "description" : "Whether clients sent before this generator started, so its own counts are less than the total.",
            "type" : "boolean"
          },
          "retries" : {
            "format" : "int64",
            "type" : "integer"
          },
          "skipped" : {
            "description" : "Transfers that were due while as many requests as allowed were open; never sent.",
            "format" : "int64",
            "type" : "integer"
          },
          "startedAt" : {
            "description" : "When this generator began to send; null while the load is off. The counts start from zero with it.",
            "format" : "date-time",
            "type" : [ "string", "null" ]
          },
          "targetTps" : {
            "description" : "New transfers a second now, the highest pulse included.",
            "format" : "int32",
            "type" : "integer"
          },
          "total" : {
            "oneOf" : [ {
              "$ref" : "#/components/schemas/ClientTotals"
            }, {
              "type" : "null"
            } ]
          },
          "unknown" : {
            "description" : "The client gave up without knowing whether the bank has the transfer.",
            "format" : "int64",
            "type" : "integer"
          }
        },
        "type" : "object"
      },
      "MinuteResponses" : {
        "description" : "How the bank answered the clients' requests that ended in one minute.",
        "properties" : {
          "baseTps" : {
            "description" : "The base load at the start of the minute, in new transfers a second.",
            "format" : "int32",
            "type" : "integer"
          },
          "busy" : {
            "description" : "Of them refused as busy (503): an answer, the transfer was not taken.",
            "format" : "int64",
            "type" : "integer"
          },
          "errors" : {
            "description" : "Of them without a usable answer: a 5xx other than busy, no connection, or no answer in time.",
            "format" : "int64",
            "type" : "integer"
          },
          "minute" : {
            "description" : "Start of the minute.",
            "format" : "date-time",
            "type" : "string"
          },
          "total" : {
            "description" : "Requests that ended in the minute, retries and duplicates included.",
            "format" : "int64",
            "type" : "integer"
          }
        },
        "type" : "object"
      },
      "MinutesPage" : {
        "description" : "Minutes without a request are left out.",
        "properties" : {
          "minutes" : {
            "items" : {
              "$ref" : "#/components/schemas/MinuteResponses"
            },
            "type" : "array"
          }
        },
        "type" : "object"
      },
      "MismatchedTransfer" : {
        "properties" : {
          "bank" : {
            "$ref" : "#/components/schemas/TransferSide"
          },
          "client" : {
            "$ref" : "#/components/schemas/TransferSide"
          },
          "transferId" : {
            "format" : "uuid",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "PeriodReconciliation" : {
        "description" : "Where the client reconciliation of a period stands. It is kept in memory: after a restart of the generator it is NOT_STARTED again.",
        "properties" : {
          "failure" : {
            "description" : "Set when FAILED.",
            "enum" : [ "PERIOD_NOT_CLOSED", "GATEWAY_UNAVAILABLE", "BAD_GATEWAY_ANSWER", "JOURNAL_UNAVAILABLE", "INTERNAL_ERROR" ],
            "type" : [ "string", "null" ]
          },
          "periodStart" : {
            "format" : "date-time",
            "type" : "string"
          },
          "report" : {
            "oneOf" : [ {
              "$ref" : "#/components/schemas/ClientReconciliationReport"
            }, {
              "type" : "null"
            } ]
          },
          "state" : {
            "enum" : [ "NOT_STARTED", "RUNNING", "DONE", "FAILED" ],
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "Pulse" : {
        "description" : "A rise of the load above its base for a while.",
        "properties" : {
          "tps" : {
            "format" : "int32",
            "type" : "integer"
          },
          "until" : {
            "format" : "date-time",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "PulseRequest" : {
        "properties" : {
          "seconds" : {
            "description" : "How long the pulse lasts, from now.",
            "format" : "int32",
            "type" : "integer"
          },
          "tps" : {
            "description" : "New transfers a second while the pulse lasts; at most the generator's ceiling.",
            "format" : "int32",
            "type" : "integer"
          }
        },
        "required" : [ "seconds", "tps" ],
        "type" : "object"
      },
      "ReconciliationBreaks" : {
        "properties" : {
          "acknowledgedNotInStatement" : {
            "$ref" : "#/components/schemas/TransferIds",
            "description" : "The bank told the client it accepted the transfer in this period; its statement does not list it."
          },
          "failedButInStatement" : {
            "$ref" : "#/components/schemas/TransferIds",
            "description" : "The client was told the bank did not take it; the statement lists it."
          },
          "notInJournal" : {
            "$ref" : "#/components/schemas/TransferIds",
            "description" : "In the bank's statement, not in the client journal."
          },
          "payloadMismatch" : {
            "$ref" : "#/components/schemas/TransferSides",
            "description" : "Accounts or amount differ."
          },
          "statusMismatch" : {
            "$ref" : "#/components/schemas/TransferSides",
            "description" : "The final status or the reject reason the client was told differs from the statement's."
          }
        },
        "type" : "object"
      },
      "StatementTotals" : {
        "properties" : {
          "amountCents" : {
            "format" : "int64",
            "type" : "integer"
          },
          "byStatus" : {
            "additionalProperties" : {
              "format" : "int64",
              "type" : "integer"
            },
            "type" : "object"
          },
          "rows" : {
            "format" : "int64",
            "type" : "integer"
          },
          "unknownToClient" : {
            "description" : "Lines whose transfer the client sent without learning the outcome, the generator's stop included.",
            "format" : "int64",
            "type" : "integer"
          }
        },
        "type" : "object"
      },
      "TransferIds" : {
        "properties" : {
          "count" : {
            "format" : "int64",
            "type" : "integer"
          },
          "transferIds" : {
            "description" : "The first of them, by id; at most the generator's example limit.",
            "items" : {
              "format" : "uuid",
              "type" : "string"
            },
            "type" : "array"
          }
        },
        "type" : "object"
      },
      "TransferSide" : {
        "description" : "One transfer as one side holds it.",
        "properties" : {
          "amountCents" : {
            "format" : "int64",
            "type" : "integer"
          },
          "fromAccount" : {
            "format" : "int32",
            "type" : "integer"
          },
          "rejectReason" : {
            "enum" : [ "INVALID_AMOUNT", "SAME_ACCOUNT", "UNKNOWN_ACCOUNT", "BLOCKED_ACCOUNT", "INSUFFICIENT_FUNDS" ],
            "type" : [ "string", "null" ]
          },
          "status" : {
            "enum" : [ "ACCEPTED", "PUBLISHED", "POSTED", "REJECTED" ],
            "type" : [ "string", "null" ]
          },
          "toAccount" : {
            "format" : "int32",
            "type" : "integer"
          }
        },
        "type" : "object"
      },
      "TransferSides" : {
        "description" : "Transfers the client and the bank hold differently.",
        "properties" : {
          "count" : {
            "format" : "int64",
            "type" : "integer"
          },
          "examples" : {
            "description" : "The first of them, by id; at most the generator's example limit.",
            "items" : {
              "$ref" : "#/components/schemas/MismatchedTransfer"
            },
            "type" : "array"
          }
        },
        "type" : "object"
      },
      "UnknownResolved" : {
        "description" : "Transfers sent in the period before whose outcome the client did not learn, by what the bank said when asked.",
        "properties" : {
          "accepted" : {
            "format" : "int64",
            "type" : "integer"
          },
          "notAccepted" : {
            "format" : "int64",
            "type" : "integer"
          }
        },
        "type" : "object"
      }
    }
  },
  "info" : {
    "description" : "The clients' load, their answers by minute and the client reconciliation of a period, for control.",
    "title" : "Ledger Lab generator internal API",
    "version" : "2"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/internal/load" : {
      "get" : {
        "operationId" : "status",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LoadStatus"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "The load now, the clients' counts since this generator started and their totals since the bank started",
        "tags" : [ "load-controller" ]
      }
    },
    "/internal/load/minutes" : {
      "get" : {
        "operationId" : "minutes",
        "parameters" : [ {
          "description" : "Only minutes after this instant; omit for all the generator keeps",
          "in" : "query",
          "name" : "after",
          "required" : false,
          "schema" : {
            "format" : "date-time",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MinutesPage"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "The bank's answers to the clients by minute, for the minutes that are over",
        "tags" : [ "load-controller" ]
      }
    },
    "/internal/load/pulse" : {
      "post" : {
        "operationId" : "pulse",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/PulseRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LoadStatus"
                }
              }
            },
            "description" : "The pulse is in effect"
          },
          "400" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "tps or seconds missing, below 1 or above the generator's ceiling"
          }
        },
        "summary" : "Raise the load for a while; of several pulses the highest sets the pace",
        "tags" : [ "load-controller" ]
      }
    },
    "/internal/periods/{periodStart}/reconciliation" : {
      "get" : {
        "operationId" : "get",
        "parameters" : [ {
          "in" : "path",
          "name" : "periodStart",
          "required" : true,
          "schema" : {
            "format" : "date-time",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PeriodReconciliation"
                }
              }
            },
            "description" : "The state now"
          },
          "404" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "Not a period, not ended yet, or older than the journal holds"
          }
        },
        "summary" : "Where the client reconciliation of a period stands, with its report once done",
        "tags" : [ "reconciliation-controller" ]
      },
      "post" : {
        "operationId" : "start",
        "parameters" : [ {
          "in" : "path",
          "name" : "periodStart",
          "required" : true,
          "schema" : {
            "format" : "date-time",
            "type" : "string"
          }
        } ],
        "responses" : {
          "202" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PeriodReconciliation"
                }
              }
            },
            "description" : "Running: started now, or already running. Poll with GET"
          },
          "404" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "Not a period, not ended yet, or older than the journal holds"
          }
        },
        "summary" : "Start the client reconciliation of a period the bank has closed",
        "tags" : [ "reconciliation-controller" ]
      }
    }
  }
}